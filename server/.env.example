# Server Configuration
PORT=10000

# PostgreSQL Database Connection String
# Local Docker Compose: postgresql://postgres:postgrespassword@localhost:5432/freshcart?schema=public
# Cloud (Neon / Supabase / Aiven / Render): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/freshcart?schema=public

# JWT Secret for signing authentication tokens
JWT_SECRET=replace_with_a_secure_random_secret_string

# Seller Admin Portal Credentials
SELLER_EMAIL=admin@freshcart.com
SELLER_PASSWORD=adminpassword123

# Razorpay Credentials (from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_secret_key

# Cloudinary (from cloudinary.com dashboard for product images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer / Gmail OTP Configuration
# Generate 16-digit App Password: Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL=your_email@gmail.com
EMAIL_PASS=your_16_digit_gmail_app_password
