generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders    Order[]
  messages  Message[]
  carts     Cart[]

  @@map("users")
}

model Product {
  id            String      @id @default(uuid())
  name          String
  description   String[]
  brand         String?
  unit          String?
  offerPrice    Float
  price         Float
  image         String[]
  category      String
  inStock       Boolean     @default(true)
  stockQuantity Int         @default(50) @map("stock_quantity")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orderItems    OrderItem[]
  cartItems     CartItem[]

  @@index([category])
  @@index([name])
  @@map("products")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @map("user_id")
  sessionId String?    @unique @map("session_id")
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id              String                 @id @default(uuid())
  userId          String                 @map("user_id")
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingAddress String                 @map("shipping_address")
  paymentMethod   String                 @map("payment_method")
  totalAmount     Float                  @map("total_amount")
  currency        String                 @default("INR")
  status          String                 @default("Order Received")
  paymentStatus   String                 @default("Pending") @map("payment_status")
  paypalOrderId   String?                @map("paypal_order_id")
  paypalCaptureId String?                @map("paypal_capture_id")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  orderItems      OrderItem[]
  payments        Payment[]
  reservations    InventoryReservation[]

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  productName String?  @map("product_name")
  unitPrice   Float?   @map("unit_price")
  packageSize String?  @map("package_size")
  subtotal    Float?

  @@map("order_items")
}

model Payment {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String   @default("PAYPAL")
  providerOrderId   String?  @map("provider_order_id")
  providerCaptureId String?  @map("provider_capture_id")
  amount            Float
  currency          String   @default("USD")
  originalAmount    Float?   @map("original_amount")
  originalCurrency  String?  @default("INR") @map("original_currency")
  exchangeRate      Float?   @map("exchange_rate")
  status            String   @default("CREATED")
  paymentMethod     String?  @map("payment_method")
  rawResponse       Json?    @map("raw_response")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([providerOrderId])
  @@index([providerCaptureId])
  @@map("payments")
}

model InventoryReservation {
  id               String   @id @default(uuid())
  orderId          String   @map("order_id")
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String   @map("product_id")
  reservedQuantity Int      @map("reserved_quantity")
  status           String   @default("RESERVED")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([productId])
  @@map("inventory_reservations")
}

model WebhookEvent {
  id               String    @id @default(uuid())
  provider         String    @default("PAYPAL")
  eventId          String    @map("event_id")
  eventType        String    @map("event_type")
  resourceId       String?   @map("resource_id")
  processingStatus String    @default("PENDING") @map("processing_status")
  payload          Json
  errorMessage     String?   @map("error_message")
  receivedAt       DateTime  @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")

  @@unique([provider, eventId])
  @@index([eventType])
  @@map("webhook_events")
}

model Message {
  id                String   @id @default(uuid())
  senderId          String   @map("sender_id")
  sender            User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message           String
  fromSeller        Boolean  @map("from_seller")
  isUnreadForSeller Boolean  @default(true) @map("is_unread_for_seller")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("messages")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  createdAt DateTime @default(now())

  @@map("otps")
}
