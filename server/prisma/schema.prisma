generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders         Order[]
  messages       Message[]
  carts          Cart[]
  conversations  ChatConversation[]
  chatMessages   ChatMessage[]
  summaries      ConversationSummary[]
  memories       UserMemory[]
  memorySettings UserMemorySetting?
  shoppingProfile UserShoppingProfile?
  productPreferences UserProductPreference[]
  brandPreferences   UserBrandPreference[]

  @@map("users")
}

model Product {
  id            String      @id @default(uuid())
  name          String
  description   String[]
  brand         String?
  unit          String?
  offerPrice    Float
  price         Float
  image         String[]
  category      String
  inStock       Boolean     @default(true)
  stockQuantity Int         @default(50) @map("stock_quantity")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orderItems    OrderItem[]
  cartItems     CartItem[]
  userPreferences UserProductPreference[]

  @@index([category])
  @@index([name])
  @@map("products")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @map("user_id")
  sessionId String?    @unique @map("session_id")
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id              String                 @id @default(uuid())
  userId          String                 @map("user_id")
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingAddress String                 @map("shipping_address")
  paymentMethod   String                 @map("payment_method")
  totalAmount     Float                  @map("total_amount")
  currency        String                 @default("INR")
  status          String                 @default("Order Received")
  paymentStatus   String                 @default("Pending") @map("payment_status")
  paypalOrderId   String?                @map("paypal_order_id")
  paypalCaptureId String?                @map("paypal_capture_id")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  orderItems      OrderItem[]
  payments        Payment[]
  reservations    InventoryReservation[]

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  productName String?  @map("product_name")
  unitPrice   Float?   @map("unit_price")
  packageSize String?  @map("package_size")
  subtotal    Float?

  @@map("order_items")
}

model Payment {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String   @default("PAYPAL")
  providerOrderId   String?  @map("provider_order_id")
  providerCaptureId String?  @map("provider_capture_id")
  amount            Float
  currency          String   @default("USD")
  originalAmount    Float?   @map("original_amount")
  originalCurrency  String?  @default("INR") @map("original_currency")
  exchangeRate      Float?   @map("exchange_rate")
  status            String   @default("CREATED")
  paymentMethod     String?  @map("payment_method")
  rawResponse       Json?    @map("raw_response")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([providerOrderId])
  @@index([providerCaptureId])
  @@map("payments")
}

model InventoryReservation {
  id               String   @id @default(uuid())
  orderId          String   @map("order_id")
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String   @map("product_id")
  reservedQuantity Int      @map("reserved_quantity")
  status           String   @default("RESERVED")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([productId])
  @@map("inventory_reservations")
}

model WebhookEvent {
  id               String    @id @default(uuid())
  provider         String    @default("PAYPAL")
  eventId          String    @map("event_id")
  eventType        String    @map("event_type")
  resourceId       String?   @map("resource_id")
  processingStatus String    @default("PENDING") @map("processing_status")
  payload          Json
  errorMessage     String?   @map("error_message")
  receivedAt       DateTime  @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")

  @@unique([provider, eventId])
  @@index([eventType])
  @@map("webhook_events")
}

model Message {
  id                String   @id @default(uuid())
  senderId          String   @map("sender_id")
  sender            User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message           String
  fromSeller        Boolean  @map("from_seller")
  isUnreadForSeller Boolean  @default(true) @map("is_unread_for_seller")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("messages")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  createdAt DateTime @default(now())

  @@map("otps")
}

model ChatConversation {
  id            String                @id @default(uuid())
  userId        String                @map("user_id")
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String                @default("New Grocery Plan")
  status        String                @default("active") // "active", "archived"
  lastMessageAt DateTime              @default(now()) @map("last_message_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  messages      ChatMessage[]
  summaries     ConversationSummary[]

  @@index([userId, status])
  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String           // "user", "assistant", "system", "tool"
  content        String
  messageType    String           @default("text") @map("message_type") // "text", "plan", "clarification"
  metadata       Json?            // Stores grocery_plan, matched_products, optimized_cart breakdown
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([userId])
  @@map("chat_messages")
}

model ConversationSummary {
  id                  String           @id @default(uuid())
  conversationId      String           @map("conversation_id")
  conversation        ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId              String           @map("user_id")
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary             String
  coveredMessageCount Int              @default(0) @map("covered_message_count")
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@index([conversationId])
  @@index([userId])
  @@map("conversation_summaries")
}

model UserMemory {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String    // "shopping_preference", "household_context", "brand_preference", "budget_preference", "dietary_preference"
  memoryKey   String    @map("memory_key") // e.g. "preferred_milk_brand", "household_size", "weekly_budget"
  memoryValue Json      @map("memory_value") // Structured value e.g. "Amul", 4, {"amount": 2500, "period": "weekly"}
  description String    // Human-readable explanation: "User prefers Amul for dairy products"
  sourceType  String    @map("source_type") // "conversation", "order_history", "user_confirmed"
  sourceId    String?   @map("source_id") // ID of conversation or order
  confidence  Float     @default(1.0)
  importance  Float     @default(0.8)
  status      String    @default("active") // "active", "superseded", "deleted"
  embedding   Json?     // Vector embedding array (e.g. 384 floats)
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, status, category])
  @@index([userId, memoryKey])
  @@map("user_memories")
}

model UserMemorySetting {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoExtract      Boolean  @default(true) @map("auto_extract")
  includeInContext Boolean  @default(true) @map("include_in_context")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("user_memory_settings")
}

model UserShoppingProfile {
  id                          String    @id @default(uuid())
  userId                      String    @unique @map("user_id")
  user                        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredCategories         Json      @default("[]") @map("preferred_categories")
  preferredBrands             Json      @default("[]") @map("preferred_brands")
  frequentlyPurchasedProducts  Json      @default("[]") @map("frequently_purchased_products")
  pricePreference             String    @default("balanced") @map("price_preference") // "budget_friendly", "balanced", "premium"
  typicalBudget               Float?    @map("typical_budget")
  budgetCurrency              String    @default("INR") @map("budget_currency")
  typicalShoppingInterval     Int?      @map("typical_shopping_interval") // days between grocery cycles
  householdSize               Int?      @map("household_size")
  lastAnalyzedAt              DateTime? @map("last_analyzed_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  @@map("user_shopping_profiles")
}

model UserProductPreference {
  id                      String    @id @default(uuid())
  userId                  String    @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId               String    @map("product_id")
  product                 Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseCount           Int       @default(0) @map("purchase_count")
  totalQuantityPurchased  Int       @default(0) @map("total_quantity_purchased")
  lastPurchasedAt         DateTime? @map("last_purchased_at")
  firstPurchasedAt        DateTime? @map("first_purchased_at")
  averagePurchaseInterval Float?    @map("average_purchase_interval") // days
  preferenceScore         Float     @default(0.0) @map("preference_score") // 0.0 to 1.0
  explicitlyPreferred     Boolean   @default(false) @map("explicitly_preferred")
  isDisliked              Boolean   @default(false) @map("is_disliked")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@index([userId, preferenceScore(sort: Desc)])
  @@map("user_product_preferences")
}

model UserBrandPreference {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand           String
  purchaseCount   Int       @default(0) @map("purchase_count")
  lastPurchasedAt DateTime? @map("last_purchased_at")
  preferenceScore     Float     @default(0.0) @map("preference_score") // 0.0 to 1.0
  explicitlyPreferred Boolean   @default(false) @map("explicitly_preferred")
  isDisliked          Boolean   @default(false) @map("is_disliked")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([userId, brand])
  @@index([userId, preferenceScore(sort: Desc)])
  @@map("user_brand_preferences")
}
